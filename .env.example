# mock = local simulator, no credentials needed · sandbox = real Yuno sandbox
YUNO_MODE=mock

# Yuno dashboard → Developers → Credentials
YUNO_PUBLIC_KEY=
YUNO_SECRET_KEY=
YUNO_ACCOUNT_ID=

# Webhook → https://<tunnel>.trycloudflare.com/webhooks/yuno
YUNO_WEBHOOK_API_KEY=
YUNO_WEBHOOK_SECRET=
YUNO_WEBHOOK_HMAC_SECRET=

PUBLIC_BASE_URL=http://localhost:5174
